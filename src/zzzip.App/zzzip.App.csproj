<Project Sdk='Microsoft.NET.Sdk'>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>zzzip</AssemblyName>
    <RootNamespace>zzzip.App</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>zzzip.App.Program</StartupObject>
    <ApplicationIcon>Assets\zzzip.ico</ApplicationIcon>
    <AssemblyTitle>zzzip</AssemblyTitle>
    <Product>zzzip 极简绿色压缩工具</Product>
    <Version>1.0.3</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\zzzip.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include='..\zzzip.Core\zzzip.Core.csproj' />
    <ProjectReference Include='..\zzzip.ShellReg\zzzip.ShellReg.csproj' />
  </ItemGroup>
</Project>